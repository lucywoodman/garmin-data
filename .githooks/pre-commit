#!/bin/sh
# Rejects the commit if any staged Go file isn't gofmt-clean, or if
# golangci-lint reports issues.
# Enable with: git config core.hooksPath .githooks

staged=$(git diff --cached --name-only --diff-filter=ACMR -- '*.go')
if [ -z "$staged" ]; then
	exit 0
fi

unformatted=""
for file in $staged; do
	# Check the staged blob, not the working tree, so partial staging can't slip through.
	if [ -n "$(git show ":$file" | gofmt -l)" ]; then
		unformatted="$unformatted $file"
	fi
done

if [ -n "$unformatted" ]; then
	echo "gofmt: these staged files need formatting:" >&2
	for file in $unformatted; do
		echo "  $file" >&2
	done
	echo "Run: gofmt -w$unformatted && git add$unformatted" >&2
	exit 1
fi

# Lints the working tree: golangci-lint type-checks whole packages, so it
# can't run against staged blobs alone.
if ! command -v golangci-lint >/dev/null; then
	echo "golangci-lint not found; install it with: mise install" >&2
	exit 1
fi
golangci-lint run ./...
